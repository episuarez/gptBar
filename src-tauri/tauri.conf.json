{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPTBar",
  "version": "0.2.2",
  "identifier": "com.episuarez.gptbar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GPTBar",
        "width": 320,
        "height": 560,
        "resizable": false,
        "center": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/episuarez/gptBar/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCMzRCQkY2NDY2QTk0NzMKUldSemxHcEc5cnMwaTBXZ2swcHVwODBMYWlZeXMydlQ5T0g2Z3NNVzFoaDU2WDhYMkNBcUpWOCsK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Monitor AI provider usage from your system tray",
    "longDescription": "GPTBar is a Windows system tray app that monitors Claude, OpenAI, Gemini, Codex and xAI usage in real time. Secure credential storage via Windows Credential Manager.",
    "category": "Utility",
    "publisher": "episuarez",
    "copyright": "Copyright (c) 2026 episuarez"
  }
}
